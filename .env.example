# ── Base de données (Postgres auto-hébergé, Coolify) ────────────────────────
# IMPORTANT : l'application doit se connecter avec un rôle NON propriétaire
# des tables, sinon FORCE ROW LEVEL SECURITY ne protège rien.
DATABASE_URL=postgresql://atelier_app:CHANGEME@postgres:5432/atelier

# Rôle de migration (propriétaire des tables). Utilisé UNIQUEMENT par drizzle-kit.
MIGRATION_DATABASE_URL=postgresql://postgres:CHANGEME@postgres:5432/atelier

# ── Auth (Better Auth) ─────────────────────────────────────────────────────
BETTER_AUTH_SECRET=generer-avec-openssl-rand-base64-32
BETTER_AUTH_URL=https://admin.votredomaine.sn
NEXT_PUBLIC_APP_URL=https://admin.votredomaine.sn

# ── Stockage média (MinIO, même VPS Coolify) ───────────────────────────────
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=atelier-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=https://media.votredomaine.sn
S3_FORCE_PATH_STYLE=true

# ── Statistiques (Umami auto-hébergé, optionnel) ───────────────────────────
UMAMI_WEBSITE_ID=
UMAMI_SCRIPT_URL=https://stats.votredomaine.sn/script.js
